# PostHog product analytics (lazy-loaded; the site works fine without these set).
# Add these in Vercel (Project → Settings → Environment Variables), then redeploy.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional — defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=
